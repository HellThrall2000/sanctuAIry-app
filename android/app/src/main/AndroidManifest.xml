<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Needed for exactly two things, both one-off: fetching the model on first
         run, and Google sign-in when the user chooses it. No conversation,
         diary entry or memory ever crosses the network. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- So a multi-gigabyte model download and a 15-30s generation are not killed
         when the screen goes off. Held with a timeout, never indefinitely. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Lets the downloader wait for Wi-Fi instead of spending a user's mobile
         data allowance on a 2.5 GB file. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Companion check-ins. Android 13+ requires this to be granted at
         runtime; it is requested the first time a check-in is scheduled
         rather than at launch. SCHEDULE_EXACT_ALARM is deliberately absent —
         check-ins use inexact scheduling, which keeps the app off a
         high-friction permission and is easier on the battery. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- So a pending check-in survives a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Lets a reply finish after the user switches away.
         Generation takes 15-30 seconds, and a backgrounded process holding a
         2.5 GB model is the first thing Android reclaims — so without this the
         reply is simply lost. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- specialUse, not shortService. shortService is capped by the platform at
         roughly three minutes and then force-stopped, which is exactly what
         killed a reply mid-generation: backgrounded inference is far slower
         than foreground, and a 24-second reply took 180 seconds with the screen
         off. specialUse exists for work that does not fit the predefined
         categories and carries no per-run ceiling. See docs/RELEASE.md — Play
         asks for written justification for this type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>

    <!-- firebase_analytics merges this in. There is no advertising in the app,
         and keeping it would oblige the Play Data safety form to declare
         advertising-ID collection. Removed, and collection disabled below. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>
    <!-- Privacy Sandbox ad permissions, merged in by the same library for the
         same reason. Removed for the same reason. -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove"/>
    <application
        android:label="sanctuAIry"
        android:name="${applicationName}"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- Backups off: the privacy policy promises that conversations, diary
             entries and memories are never uploaded, and Android Auto Backup
             would otherwise copy the app's databases to the user's Google Drive.
             Restored flutter_secure_storage data also fails to decrypt on a new
             device (the Keystore key does not travel), which crashes on read.
             allowBackup covers Android 11 and below; dataExtractionRules covers
             12+, including device-to-device transfer. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:value="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Holds the process alive while a reply is being written. See
             GenerationService for why a wake lock alone is not enough. -->
        <service
            android:name=".GenerationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device language model inference. The user has
                    sent a message and the reply is computed locally on the CPU;
                    it must finish even if they switch away, and nothing leaves
                    the device." />
        </service>

        <!-- See the AD_ID removal above. -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
