<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon layer for Android 13+. The launcher recolours this silhouette to
  match the user's wallpaper, so it must be a single flat shape — colour here is
  ignored entirely.

  The arch geometry matches the foreground PNGs exactly (see the make_icons.py
  header): 30.24 wide, springing at y=43.2, feet at y=84.24 on the 108 grid. The
  sage circle becomes a punched hole via evenOdd, because a themed icon has no
  second colour to render it in.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M38.88,84.24 L38.88,43.2 A15.12,15.12 0 0 1 69.12,43.2 L69.12,84.24 Z M60.7,43.2 A6.7,6.7 0 1 1 47.3,43.2 A6.7,6.7 0 1 1 60.7,43.2 Z" />
</vector>
