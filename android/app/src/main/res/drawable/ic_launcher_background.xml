<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: the terracotta field, as a gradient rather than a
  flat fill so the tile has some depth behind the arch.

  Kept as a vector rather than five PNG buckets because it is two colours and a
  rectangle — a vector is smaller and cannot be resampled wrong. Adaptive icons
  are API 26+, well past the API 24 that gradient support in vectors requires.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108"
                android:startColor="#D67F48"
                android:endColor="#C67139" />
        </aapt:attr>
    </path>
</vector>
